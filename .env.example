# fing 环境变量模板
# 用法：
#   cp .env.example .env
#   vim .env   # 改你的实际配置
#
# 本地开发：直接 go run main.go（用 config.development.yaml）
# Docker：docker compose up -d（用 config.docker.yaml，自动读 .env）
#
# === MySQL ===
# 本地默认（与 docker-compose 一致）
DATABASE_URL=fing:fingpass@tcp(localhost:3306)/fing?charset=utf8mb4&parseTime=True&loc=Local

# === Redis ===
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# === 应用 ===
APP_SECRET=please-change-this-in-production-use-a-long-random-string-min-32-chars
APP_PORT=9765
APP_MODE=dev

# === Elasticsearch（可选，不填就跳过）===
ES_URL=
ES_USERNAME=
ES_PASSWORD=

# === 邮件（可选，注册欢迎邮件 / 密码重置） ===
# Gmail 用 App Password：https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_NAME=Your Name
EMAIL_ADDRESS=your@email.com
EMAIL_PASSWORD=your-app-password

# === Docker compose 内部用 ===
# 这两个会被 docker-compose 读，fing 服务本身不用
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=fing
MYSQL_USER=fing
MYSQL_PASSWORD=fingpass